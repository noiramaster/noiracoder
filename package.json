{
  "name": "noiracoder",
  "version": "0.2.8",
  "description": "NoiraCoder - agential coding harness for the Noira ecosystem (multi-provider, cache-aware, sandboxed).",
  "license": "MIT",
  "author": "Kujtim Hoxha (OpenCode)",
  "exports": {
    ".": "./dist/index.js"
  },
  "type": "module",
  "bin": {
    "noiracoder": "bin/noiracoder.mjs",
    "noira": "bin/noiracoder.mjs",
    "nc": "bin/noiracoder.mjs"
  },
  "files": [
    "dist",
    "bin/noiracoder.mjs",
    "skills"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:thin": "node scripts/build-thin.mjs",
    "build:thin:all": "node scripts/build-thin-all.mjs",
    "check:artifacts": "node scripts/check-release.mjs --artifacts-only",
    "prepack": "npm run build && node scripts/build-thin.mjs && node scripts/check-release.mjs --artifacts-only",
    "prepublishOnly": "node scripts/check-release.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "dev": "tsc -p tsconfig.json --watch",
    "smoke": "node dist/index.js --version",
    "test:e2e": "npm run build && node test/e2e.mjs",
    "test:sanitize": "npm run build && node test/sanitize.mjs",
    "test:i18n": "node test/i18n.mjs",
    "test:i18n:screen": "npm run build && node test/i18n-screen.mjs",
    "test:adversarial": "npm run build && node test/adversarial.mjs",
    "test:antileak": "npm run build && node test/antileak.mjs",
    "test:memory-guard": "npm run build && node test/memory-guard.mjs",
    "test:titles": "npm run build && node test/titles.mjs",
    "test:learn": "npm run build && node test/learn.mjs",
    "bench": "npm run build && node test/bench.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "ink": "^7.1.1",
    "react": "^19.2.8",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@modelcontextprotocol/server-everything": "^2026.8.31",
    "@modelcontextprotocol/server-filesystem": "^2026.8.31",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.18",
    "typescript": "^5.6.0"
  },
  "optionalDependencies": {
    "@noiramaster/noiracoder-win32-x64": "0.2.8",
    "noiracoder-darwin-x64": "0.2.8",
    "noiracoder-darwin-arm64": "0.2.8",
    "noiracoder-linux-x64": "0.2.8"
  },
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noiramaster/noiracoder.git"
  },
  "keywords": [],
  "bugs": {
    "url": "https://github.com/noiramaster/noiracoder/issues"
  },
  "homepage": "https://github.com/noiramaster/noiracoder#readme"
}
