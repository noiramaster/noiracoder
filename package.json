{
  "name": "noiracoder",
  "version": "0.1.0",
  "description": "NoiraCoder - agential coding harness for the Noira ecosystem (multi-provider, cache-aware, sandboxed).",
  "type": "module",
  "license": "MIT",
  "bin": {
    "noiracoder": "bin/noiracoder.mjs",
    "noira": "bin/noiracoder.mjs",
    "nc": "bin/noiracoder.mjs"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "bin/noiracoder.mjs",
    "skills",
    "scripts/fetch-go-binary.mjs"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "postinstall": "node scripts/fetch-go-binary.mjs || true",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "dev": "tsc -p tsconfig.json --watch",
    "smoke": "node dist/index.js --version",
    "test:e2e": "npm run build && node test/e2e.mjs",
    "test:sanitize": "npm run build && node test/sanitize.mjs",
    "test:i18n": "node test/i18n.mjs",
    "test:adversarial": "npm run build && node test/adversarial.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "ink": "^7.1.1",
    "react": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.18",
    "typescript": "^5.6.0"
  }
}
